# 로컬 인프라 설정 예시 — 필요할 때만 .env로 복사해서 수정 (.env는 커밋되지 않음)
# cp .env.example .env

# 이미지 버전
KAFKA_VERSION=4.3.1
REDIS_VERSION=8.2.9
RABBITMQ_VERSION=4.2.9

# 호스트에 노출할 포트
KAFKA_PORT=9092
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# 접속 정보 (로컬 개발용 기본값)
REDIS_PASSWORD=localredis
RABBITMQ_USER=local
RABBITMQ_PASSWORD=localrabbit
RABBITMQ_VHOST=/

# Kafka KRaft 클러스터 식별자 — 볼륨을 초기화하지 않은 상태에서 바꾸면 기동에 실패
KAFKA_CLUSTER_ID=krr-local-cluster-0
